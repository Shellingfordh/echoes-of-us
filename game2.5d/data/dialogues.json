    ],
    "next": "END"
  },
  "D014": {
    "mode": "dialogue",
    "blocking": true,
    "speaker": "余秀兰",
    "portrait": "res://art/portraits/chapter1/余秀兰（48）：阴…….png",
    "lines": [
