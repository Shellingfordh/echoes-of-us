  "D001": {
    "mode": "dialogue",
    "blocking": false,
    "speaker": "余念",
    "portrait": "res://art/portraits/chapter1/余念（23）：强忍悲戚.png",
    "lines": ["终于封上了……累死了。", "三箱。衣服一箱，书一箱，剩下乱七八糟的塞一箱。", "二十三年，收拾到最后也就这么点。"],
    "next": "END"
  },
  "D002": {
    "mode": "dialogue",
    "blocking": false,
    "speaker": "余念",
    "portrait": "res://art/portraits/chapter1/余念（23）：烦躁郁闷.png",
    "lines": ["保温杯、苹果、胃药……", "我什么时候装的？", "……行。知道是谁了。"],
    "next": "END"
  },
  "D003": {
    "mode": "dialogue",
    "blocking": false,
    "speaker": "余念",
    "portrait": "res://art/portraits/chapter1/余念（23）：正常状态.png",
    "lines": ["票，通知……都在。", "两点零五。明早六点四十到。还挺久。", "……这印子怎么擦不掉。", "算了。"],
    "next": "END"
  },
  "D004": {
    "mode": "dialogue",
    "blocking": false,
    "speaker": "余念",
    "portrait": "res://art/portraits/chapter1/余念（23）：欣然愉悦.png",
    "lines": ["还行。看着挺像那么回事。"],
    "next": "END"
  },
  "D005": {
    "mode": "dialogue",
    "speaker": "余秀兰",
    "portrait": "res://art/portraits/chapter1/余秀兰（48）：欣然愉悦.png",
    "lines": ["雨伞没拿，来，给你装上。你这拉链怎么又卡了？"],
    "next": "D006"
  },
  "D006": {
    "mode": "dialogue",
    "speaker": "余秀兰",
    "portrait": "res://art/portraits/chapter1/余秀兰（48）：满眼宠溺.png",
    "lines": ["那边这两天有雨。塞着吧，省得到地方现买。"],
    "next": "D007"
  },
  "D007": {
    "mode": "dialogue",
    "speaker": "余念",
    "portrait": "res://art/portraits/chapter1/余念（23）：烦躁郁闷.png",
    "lines": ["妈，真塞不下了，你别硬塞啊。"],
    "next": "D008"
  },
  "D008": {
    "mode": "dialogue",
    "speaker": "余念",
    "portrait": "res://art/portraits/chapter1/余念（23）：正常状态.png",
    "lines": ["到那儿再买就行，便利店多的是。"],
    "next": "D009"
  },
  "D009": {
    "mode": "dialogue",
    "speaker": "余秀兰",
    "portrait": "res://art/portraits/chapter1/余秀兰（48）：正常状态.png",
    "lines": ["十几二十块不是钱啊？家里有，还买。"],
    "next": "D010"
  },
  "D010": {
    "mode": "dialogue",
    "speaker": "余秀兰",
    "portrait": "res://art/portraits/chapter1/余秀兰（48）：满眼宠溺.png",
    "lines": ["还有这两盒药你别给我拿出来，啊，你一忙起来，饭都不按点吃。"],
    "next": "D011"
  },
  "D011": {
    "mode": "dialogue",
    "speaker": "余秀兰",
    "portrait": "res://art/portraits/chapter1/余秀兰（48）：强忍悲戚.png",
    "lines": ["你说你……非得跑那么远干什么。省城不是也有工作吗？"],
    "next": "D012"
  },
  "D012": {
    "mode": "dialogue",
    "speaker": "余念",
    "portrait": "res://art/portraits/chapter1/余念（23）：烦躁郁闷.png",
    "lines": ["妈，你说，这伞都多少年了，骨架都松了，我带它干什么。"],
    "next": "D013"
  },
  "D013": {
    "mode": "dialogue",
    "speaker": "余秀兰",
    "portrait": "res://art/portraits/chapter1/余秀兰（48）：强忍悲戚.png",
    "lines": ["行。你不要就不要。"],
    "next": "D014"
  },
  "D014": {
    "mode": "dialogue",
    "speaker": "余秀兰",
    "portrait": "res://art/portraits/chapter1/余秀兰（48）：正常状态.png",
    "lines": ["放这儿了。爱拿不拿。"],
    "next": "END"
  },
  "D015": {
    "mode": "dialogue",
    "blocking": false,
    "speaker": "余念",
    "portrait": "res://art/portraits/chapter1/余念（23）：难以置信.png",
    "lines": ["怎么又回来了？"],
    "next": "D016"
  },
  "D016": {
    "mode": "dialogue",
    "blocking": false,
    "speaker": "余念",
    "portrait": "res://art/portraits/chapter1/余念（23）：难以置信.png",
    "lines": ["……线？"],
    "next": "END"
  },
  "D017": {
    "mode": "dialogue",
    "blocking": false,
    "speaker": "余念",
    "portrait": "res://art/portraits/chapter1/余念（23）：难以置信.png",
    "lines": ["不是幻觉？这是怎么回事？"],
    "next": "D018"
  },
  "D018": {
    "mode": "dialogue",
    "speaker": "余念",
    "portrait": "res://art/portraits/chapter1/余念（23）：强忍悲戚.png",
    "lines": ["……妈妈不想让我走？"],
    "next": "END"
  },
  "D041": {
    "mode": "dialogue",
    "blocking": false,
    "speaker": "余念",
    "portrait": "res://art/portraits/chapter1/余念（23）：欣然愉悦.png",
    "lines": ["真是的，我的耳机，找了一星期，原来在这儿。", "……这种地方也就我进得来。"],
    "next": "END"
  },
  "D042": {
    "mode": "dialogue",
    "blocking": false,
    "speaker": "余念",
    "portrait": "res://art/portraits/chapter1/余念（23）：欣然愉悦.png",
    "lines": ["小学春游……我站哪儿呢。", "哦，这儿，妈还站最后一排，她那时候头发这么长啊。", "这张怎么搁这么高。"],
    "next": "END"
  },
  "D043": {
    "mode": "dialogue",
    "blocking": false,
    "speaker": "余念",
    "portrait": "res://art/portraits/chapter1/余念（23）：强忍悲戚.png",
    "lines": ["这件衣服还在啊。领口都硬了。", "我都说多少次了，留着也没人穿。", "……算了。她爱留就留着吧。"],
    "next": "END"
  },
  "D044": {
    "mode": "dialogue",
    "blocking": false,
    "speaker": "余念",
    "portrait": "res://art/portraits/chapter1/余念（23）：欣然愉悦.png",
    "lines": ["这线，都戴得起毛了。", "……回头换一根。"],
    "next": "END"
  },
  "D045": {
    "mode": "dialogue",
    "blocking": false,
    "speaker": "余念",
    "portrait": "res://art/portraits/chapter1/余念（23）：烦躁郁闷.png",
    "lines": ["……又多两盒。", "她什么时候塞的。"],
    "next": "END"
  },
  "D046": {
    "mode": "dialogue",
    "blocking": false,
    "speaker": "余念",
    "portrait": "res://art/portraits/chapter1/余念（23）：正常状态.png",
    "lines": ["这伞，我小时候买的，现在猫脸都要掉没了，伞骨也松了。", "……她怎么什么都要留着。"],
    "next": "END"
  },
  "D047": {
    "mode": "dialogue",
    "blocking": false,
    "speaker": "余念",
    "portrait": "res://art/portraits/chapter1/余念（23）：烦躁郁闷.png",
    "lines": ["线？好多的线，它们一直都在这儿，我以前，好像从没注意到……"],
    "next": "END"
  },

  "D019": {
    "mode": "dialogue",
    "speaker": "七岁余念",
    "portrait": "res://art/portraits/chapter2/余念（7）：欣然愉悦.png",
    "lines": ["妈妈你快点！我先走啦！"],
