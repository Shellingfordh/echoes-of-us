; Godot 4.x project for the standalone 2.5D first chapter.

config_version=5

[application]

config/name="余响：牵挂 · 第一章 2.5D"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.09, 0.078, 0.073, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=1440
window/size/viewport_height=810
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.09, 0.078, 0.073, 1)
textures/default_filters/use_nearest_mipmap_filter=false
