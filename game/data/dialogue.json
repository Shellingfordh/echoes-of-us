{
  "version": 1,
  "entries": {
    "D001": {"speaker": "余念 · 心声", "text": "胶带封得很死。几件外套、耳机，还有几本书。把二十多年装进几个箱子里，比想象中容易。", "emotion": "平静、自我确认", "blocking": false, "duration": 2.8},
    "D002": {"speaker": "余念 · 心声", "text": "胃药、水果、保温杯……它们总能精准地出现在我的行李里。东西当然没错，只是从来没人问我需不需要。", "emotion": "无奈、边界被侵入", "blocking": false, "duration": 3.0},
    "D003": {"speaker": "余念 · 心声", "text": "东西都带齐了。桌面还留着一块浅色印子……有些痕迹，好像不是收拾干净就能带走的。", "emotion": "柔软、迟疑", "blocking": false, "duration": 2.9},
    "D004": {"speaker": "余念 · 心声", "text": "还是这个房间。只是换个位置看，怎么突然像别人的了。", "emotion": "好奇、轻微陌生", "blocking": false, "duration": 2.4},
    "D005": {"speaker": "余秀兰", "text": "伞你没拿。哎，这拉链怎么又不顺了？", "emotion": "自然、忙碌", "blocking": true, "duration": 1.8},
    "D006": {"speaker": "余秀兰", "text": "天气预报说你那边明天有大阵雨，这把伞我给你塞这儿。", "emotion": "关心、习惯性安排", "blocking": true, "duration": 2.2},
    "D007": {"speaker": "余念", "text": "妈，别塞了，真的放不下。", "emotion": "克制", "blocking": true, "duration": 1.7},
    "D008": {"speaker": "余念", "text": "小区楼下就有便利店。真下雨了，我自己买一把就行。", "emotion": "理性、保持距离", "blocking": true, "duration": 2.1},
    "D009": {"speaker": "余秀兰", "text": "外面买多贵啊，家里有现成的不用。", "emotion": "焦虑、固执", "blocking": true, "duration": 1.9},
    "D010": {"speaker": "余秀兰", "text": "你刚工作，钱省着点花。胃不好，药也别嫌沉。", "emotion": "担心、絮叨", "blocking": true, "duration": 2.1},
    "D011": {"speaker": "余秀兰", "text": "再说，在家住得好好的，非得搬出去吗？", "emotion": "不舍、试探", "blocking": true, "duration": 2.1},
    "D012": {"speaker": "余念", "text": "现在伞哪儿都有卖的。何况这把伞骨架都松了。", "emotion": "冷下来、防御", "blocking": true, "duration": 2.0},
    "D013": {"speaker": "余秀兰", "text": "……算了，随你吧。", "emotion": "受伤、收回情绪", "blocking": true, "duration": 1.6},
    "D014": {"speaker": "余秀兰", "text": "反正外面什么都有卖的。", "emotion": "假装轻松、失落", "blocking": true, "duration": 1.8},
    "D015": {"speaker": "余念 · 心声", "text": "为什么……走不出去？", "emotion": "震惊、受挫", "blocking": false, "duration": 1.6},
    "D016": {"speaker": "余念 · 心声", "text": "这是什么？一根线……它连着妈妈？", "emotion": "错愕、警惕", "blocking": false, "duration": 2.1},
    "D017": {"speaker": "余念 · 心声", "text": "它在托着我……不，它真的能拉住人。", "emotion": "惊讶、危险感", "blocking": false, "duration": 2.2},
    "D018": {"speaker": "余念 · 心声", "text": "所以，是妈妈不想让我走吗？", "emotion": "委屈、抗拒、误解成立", "blocking": true, "duration": 2.4},
    "D019": {"speaker": "七岁的余念", "text": "妈妈，我先过去！", "emotion": "兴奋、迫不及待", "blocking": false, "duration": 1.4},
    "D020": {"speaker": "年轻的余秀兰", "text": "慢一点，别跑那么快。", "emotion": "紧张、熟悉这根线", "blocking": false, "duration": 1.6},
    "D021": {"speaker": "年轻的余秀兰", "text": "等等！", "emotion": "本能保护、惊慌", "blocking": false, "duration": 1.0},
    "D022": {"speaker": "七岁的余念", "text": "妈妈？你为什么又拉我？", "emotion": "疑惑、小小不满", "blocking": false, "duration": 1.8},
    "D023": {"speaker": "七岁的余念", "text": "这里我能过去。你在那边等我！", "emotion": "自信、想证明自己", "blocking": false, "duration": 2.0},
    "D024": {"speaker": "年轻的余秀兰", "text": "余念！别往下看，抓住线，慢慢爬回来。妈妈在这儿。", "emotion": "恐惧、强迫自己镇定", "blocking": false, "duration": 2.6},
    "D025": {"speaker": "年轻的余秀兰", "text": "去吧。慢一点……到了就回头让我看一眼。", "emotion": "不舍、温柔、第一次放手", "blocking": false, "duration": 2.5},
    "D026": {"speaker": "余秀兰", "text": "念念？发什么呆呢？", "emotion": "担心、试探", "blocking": true, "duration": 1.7},
    "D027": {"speaker": "余念", "text": "没事。箱子一人一个吧，别都抢过去。", "emotion": "缓和、仍有一点生疏", "blocking": false, "duration": 2.1},
    "D028": {"speaker": "余秀兰", "text": "我站稳了。你先过去，别回头拽我。", "emotion": "专注、信任", "blocking": false, "duration": 2.0},
    "D029": {"speaker": "余念", "text": "妈，这回换我。你慢慢来，我拉得住。", "emotion": "认真、柔软、关系反转", "blocking": false, "duration": 2.1},
    "D030": {"speaker": "余念", "text": "箱子你能推，我从旁边过去。等我把里面的路打开。", "emotion": "清晰、开始默契", "blocking": false, "duration": 2.3},
    "D031": {"speaker": "余秀兰", "text": "行。你先走你的，到了叫我一声。", "emotion": "克制、愿意等待", "blocking": false, "duration": 2.0},
    "D032": {"speaker": "余秀兰", "text": "别急着把我也带上去。你先站稳。", "emotion": "沉着、把主动权交给女儿", "blocking": false, "duration": 2.0},
    "D033": {"speaker": "余念", "text": "好了，妈。现在到你了。", "emotion": "信任、轻盈、平等", "blocking": false, "duration": 1.8},
    "D034": {"speaker": "余秀兰", "text": "这个放这儿顺手。冰箱我再给你装点吃的，窗帘也得换，周末我过来——", "emotion": "关心、重新越界", "blocking": true, "duration": 2.8},
    "D035": {"speaker": "余念", "text": "妈，够了。这是我住的地方，让我自己决定行吗？", "emotion": "疲惫、边界被再次触碰", "blocking": true, "duration": 2.3},
    "D036": {"speaker": "余秀兰", "text": "……行。以后你的事，我不问了。", "emotion": "受伤、防御、把放手误解成退出", "blocking": true, "duration": 2.1},
    "D037": {"speaker": "", "text": "", "emotion": "空、冻结、不安", "blocking": true, "duration": 2.5},
    "D038": {"speaker": "余念 · 心声", "text": "我想要的……不是这样。", "emotion": "失落、开始辨认真正需要的距离", "blocking": false, "duration": 2.0},
    "D039": {"speaker": "余秀兰", "text": "那我先回去了。缺什么，你想说的时候再告诉我。", "emotion": "克制、尊重、真正放手", "blocking": true, "duration": 2.5},
    "D040": {"speaker": "", "text": "", "emotion": "温柔、安定、余韵", "blocking": true, "duration": 2.5},
    "C001": {"speaker": "余念 · 心声", "text": "椅子还在原来的位置。", "emotion": "怀念", "blocking": false, "duration": 1.8},
    "M001": {"speaker": "记忆碎片", "text": "这是妈妈送我去学校的路。", "emotion": "温暖", "blocking": false, "duration": 2.2},
    "M002": {"speaker": "记忆碎片", "text": "又长高了。", "emotion": "轻快", "blocking": false, "duration": 1.6},
    "M003": {"speaker": "记忆碎片", "text": "小时候我最讨厌穿雨靴。", "emotion": "怀念", "blocking": false, "duration": 2.0},
    "M004": {"speaker": "记忆碎片", "text": "小学春游的合影。她的手悬在我肩膀上方，没敢搭下来。", "emotion": "柔软", "blocking": false, "duration": 2.6},
    "M005": {"speaker": "记忆碎片", "text": "找了一星期，原来在这儿。……这种地方也就我能进来。", "emotion": "轻微自嘲", "blocking": false, "duration": 2.5},
    "E001": {"speaker": "远处的回响", "text": "吃饭了——", "emotion": "日常", "blocking": false, "duration": 2.0},
    "E002": {"speaker": "远处的回响", "text": "我回来啦！", "emotion": "遥远", "blocking": false, "duration": 2.0},
    "E003": {"speaker": "远处的回响", "text": "♪ 一段很轻的哼唱……", "emotion": "安静", "blocking": false, "duration": 2.4},
    "A101": {"speaker": "余念 · 心声", "text": "小时候下雨，她总把伞往我这边倾。", "emotion": "记忆被唤醒", "blocking": true, "duration": 2.4},
    "A201": {"speaker": "七岁的余念", "text": "妈妈好厉害！", "emotion": "崇拜", "blocking": false, "duration": 1.7},
    "A202": {"speaker": "年轻的余秀兰 · 心声", "text": "松开，不代表失去连接。", "emotion": "理解", "blocking": true, "duration": 2.1},
    "A203": {"speaker": "七岁的余念", "text": "妈妈——我到啦！", "emotion": "兴奋", "blocking": true, "duration": 1.8},
    "A204": {"speaker": "年轻的余秀兰 · 心声", "text": "牵挂，不只是拉住，也可以守护。", "emotion": "第一次放手", "blocking": true, "duration": 2.6},
    "A301": {"speaker": "余念 · 心声", "text": "不是切断它，而是换一种连接方式。", "emotion": "理解", "blocking": true, "duration": 2.4},
    "W001": {"speaker": "路人", "text": "我的钥匙……好像掉在附近了。", "emotion": "焦急", "blocking": false, "duration": 2.2},
    "W002": {"speaker": "路人", "text": "啊，原来掉在花坛边了。", "emotion": "释然", "blocking": false, "duration": 1.9},
    "W003": {"speaker": "余念 · 心声", "text": "原来不只有我和妈妈之间有这种线。", "emotion": "世界被打开", "blocking": false, "duration": 2.6},
    "A401": {"speaker": "余念 · 心声", "text": "线……在延伸？", "emotion": "惊讶、释然", "blocking": false, "duration": 2.0},
    "A402": {"speaker": "余秀兰 · 心声", "text": "去吧。", "emotion": "平静、放手", "blocking": true, "duration": 2.0},
    "A403": {"speaker": "余念 · 心声", "text": "人可以离开彼此，关系不一定因此断裂。", "emotion": "理解、安定", "blocking": true, "duration": 2.8}
  }
}
