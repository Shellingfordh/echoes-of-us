{
  "_comment": "第一章屋内对白 Source of Truth。依据 docs/narrative/03_剧情对白表.md；剧情同学只改 speaker、lines、next。",
  "_schema": "mode = monologue/dialogue；speaker = 说话人；lines = 当前节点的句子；next = 下一节点 ID 或 END。",

  "D001": {
    "mode": "monologue",
    "speaker": "余念·独白",
    "lines": ["终于封上了……累死了。", "三箱。衣服一箱，书一箱，剩下乱七八糟的塞一箱。", "二十三年，收拾到最后也就这么点。"],
    "next": "END"
  },
  "D002": {
    "mode": "monologue",
    "speaker": "余念·独白",
    "lines": ["保温杯、苹果、胃药……", "我什么时候装的？", "……行。知道是谁了。"],
    "next": "END"
  },
  "D003": {
    "mode": "monologue",
    "speaker": "余念·独白",
    "lines": ["票，通知……都在。", "两点零五。明早六点四十到。还挺久。", "……这印子怎么擦不掉。", "算了。"],
    "next": "END"
  },
  "D004": {
    "mode": "monologue",
    "speaker": "余念·独白",
    "lines": ["还行。看着挺像那么回事。"],
    "next": "D044"
  },
  "D005": {
    "mode": "dialogue",
    "speaker": "余秀兰",
    "lines": ["伞没拿。你这拉链怎么又卡了？"],
    "next": "D006"
  },
  "D006": {
    "mode": "dialogue",
    "speaker": "余秀兰",
    "lines": ["那边这两天有雨。塞着吧，省得到地方现买。"],
    "next": "D007"
  },
  "D007": {
    "mode": "dialogue",
    "speaker": "余念",
    "lines": ["妈，真塞不下了，你别硬塞啊。"],
    "next": "D008"
  },
  "D008": {
    "mode": "dialogue",
    "speaker": "余念",
    "lines": ["到那儿再买就行，便利店多的是。"],
    "next": "D009"
  },
  "D009": {
    "mode": "dialogue",
    "speaker": "余秀兰",
    "lines": ["十几二十块不是钱啊？家里有，还买。"],
    "next": "D010"
  },
  "D010": {
    "mode": "dialogue",
    "speaker": "余秀兰",
    "lines": ["还有这两盒药你别给我拿出来，啊，你一忙起来，饭都不按点吃。"],
    "next": "D011"
  },
  "D011": {
    "mode": "dialogue",
    "speaker": "余秀兰",
    "lines": ["你说你……非得跑那么远干什么。省城不是也有工作吗？"],
    "next": "D012"
  },
  "D012": {
    "mode": "dialogue",
    "speaker": "余念",
    "lines": ["妈，你说，这伞都多少年了，骨架都松了，我带它干什么。"],
    "next": "D013"
  },
  "D013": {
    "mode": "dialogue",
    "speaker": "余秀兰",
    "lines": ["行。你不要就不要。"],
    "next": "D014"
  },
  "D014": {
    "mode": "dialogue",
    "speaker": "余秀兰",
    "lines": ["放这儿了。爱拿不拿。"],
    "next": "END"
  },
  "D015": {
    "mode": "monologue",
    "speaker": "余念",
    "lines": ["怎么又回来了？"],
    "next": "D016"
  },
  "D016": {
    "mode": "monologue",
    "speaker": "余念",
    "lines": ["……线？"],
    "next": "END"
  },
  "D017": {
    "mode": "monologue",
    "speaker": "余念",
    "lines": ["等等……它托得住我？"],
    "next": "D018"
  },
  "D018": {
    "mode": "dialogue",
    "speaker": "余念",
    "lines": ["……妈妈不想让我走？"],
    "next": "END"
  },
  "D041": {
    "mode": "monologue",
    "speaker": "余念·独白",
    "lines": ["真是的，我的耳机，找了一星期，原来在这儿。", "……这种地方也就我进得来。"],
    "next": "END"
  },
  "D042": {
    "mode": "monologue",
    "speaker": "余念·独白",
    "lines": ["小学春游……我站哪儿呢。", "哦，这儿。", "妈还站最后一排。她那时候头发这么长啊。", "这张怎么搁这么高。"],
    "next": "END"
  },
  "D043": {
    "mode": "monologue",
    "speaker": "余念·独白",
    "lines": ["这件还在啊。领口都硬了。", "我都说多少次了，留着也没人穿。", "……算了。她爱留就留着吧。"],
    "next": "END"
  },
  "D044": {
    "mode": "monologue",
    "speaker": "余念·独白",
    "lines": ["这线都起毛了。", "……回头换一根。"],
    "next": "END"
  },
  "D045": {
    "mode": "monologue",
    "speaker": "余念·独白",
    "lines": ["……又多两盒。", "她什么时候塞的。"],
    "next": "END"
  },
  "D046": {
    "mode": "monologue",
    "speaker": "余念·独白",
    "lines": ["这伞还在啊。", "猫脸都要掉没了，伞骨也松了。", "……她怎么什么都留。"],
    "next": "END"
  },
  "D047": {
    "mode": "monologue",
    "speaker": "余念·独白",
    "lines": ["它们一直都在这儿。"],
    "next": "END"
  }
}
